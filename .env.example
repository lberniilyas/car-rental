# ==========================================================================
# Kiraa — variables d'environnement (EXEMPLE, aucune valeur secrète ici)
# Copier vers .env.local puis renseigner les valeurs réelles.
# Le fichier .env.local est ignoré par git et ne doit JAMAIS être commité.
# ==========================================================================

# --- Base de données PostgreSQL + pgvector -------------------------------
POSTGRES_USER=kiraa
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kiraa
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://kiraa:change_me@localhost:5433/kiraa

# --- Fournisseur LLM (extraction / intention / explication uniquement) ---
# Aucun calcul financier ni décision réglementaire n'est délégué au LLM.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30

# --- Embeddings (compatibles pgvector, similarité cosinus) ---------------
# Exécution LOCALE : aucune clé API, aucun appel réseau, fonctionne hors ligne.
# Modèle Xenova/all-MiniLM-L6-v2 — 384 dimensions — similarité cosinus.
# Le modèle (~90 Mo) est téléchargé et mis en cache au premier indexage.
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDINGS_DIMENSION=384

# --- Application ---------------------------------------------------------
NODE_ENV=development
PORT=3000
MAX_UPLOAD_SIZE_MB=10
OCR_CONFIDENCE_THRESHOLD=0.85

# --- Routes d'administration protégées -----------------------------------
ADMIN_TOKEN=
